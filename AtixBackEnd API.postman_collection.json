{
	"info": {
		"_postman_id": "atixbackend-api-collection",
		"name": "AtixBackEnd API",
		"description": "Complete REST API collection for AtixBackEnd - Work and Ticket Management System\n\nThis collection includes all endpoints for:\n- Authentication (JWT-based)\n- User Management\n- Client Management\n- Plant Management\n- Ticket Management\n- Work Management\n- Work Reports\n- Worksite References\n- File Attachments (Cloudinary)\n- Dashboard (GraphQL)\n\nAuthentication:\n- Public endpoints: /auth/register, /auth/login\n- Protected endpoints: Require Bearer token from login response\n\nRoles:\n- USER: Basic access\n- ADMIN: Administrative access\n- OWNER: Full access",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"description": "Authentication endpoints - public access",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Mario\",\n  \"lastName\": \"Rossi\",\n  \"email\": \"mario.rossi@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"USER\",\n  \"type\": \"TECHNICIAN\"\n}"
						}
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('token', response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"mario.rossi@example.com\",\n  \"password\": \"Password123!\"\n}"
						}
					},
					"response": []
				},
				{
					"name": "Update Password",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "password"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword456!\"\n}"
						}
					},
					"response": []
				}
			]
		},
