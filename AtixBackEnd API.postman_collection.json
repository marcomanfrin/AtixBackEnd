			"description": "GraphQL endpoint for dashboard summary",
			"item": [
				{
					"name": "Dashboard Summary Query",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": ["{{baseUrl}}"],
							"path": ["graphql"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query { dashboardSummary(limit: 10) { clientsCount plantsCount completedWorksCount pendingWorksCount ticketsByStatus { status count } lastWorks { id name completed createdAt } lastTickets { id name status createdAt } } }\"\n}"
						}
					},
					"response": []
				},
				{
					"name": "Dashboard Summary (GraphiQL format)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
