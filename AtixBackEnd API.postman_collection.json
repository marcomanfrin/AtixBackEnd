							}
						],
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": ["{{baseUrl}}"],
							"path": ["graphql"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"query DashboardSummary($limit: Int) {\\n  dashboardSummary(limit: $limit) {\\n    clientsCount\\n    plantsCount\\n    completedWorksCount\\n    pendingWorksCount\\n    ticketsByStatus {\\n      status\\n      count\\n    }\\n    lastWorks {\\n      id\\n      name\\n      completed\\n      createdAt\\n    }\\n    lastTickets {\\n      id\\n      name\\n      status\\n      createdAt\\n    }\\n  }\\n}\",\n  \"variables\": {\n    \"limit\": 5\n  }\n}"
						}
					},
					"response": []
				}
			]
