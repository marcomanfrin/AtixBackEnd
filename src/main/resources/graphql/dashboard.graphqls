type DashboardSummary {
    clientsCount: Int!
    plantsCount: Int!

    completedWorksCount: Int!
    pendingWorksCount: Int!
    ticketsByStatus: [TicketStatusCount!]!

    lastWorks: [WorkPreview!]!
    lastTickets: [TicketPreview!]!
}

type TicketStatusCount { status: TicketStatus! count: Int! }

enum TicketStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED
}

type WorkPreview {
    id: ID!
    name: String!
    completed: Boolean!
    createdAt: String!
}

type TicketPreview {
    id: ID!
    name: String!
    status: TicketStatus!
    createdAt: String!
}

type Query {
    dashboardSummary(limit: Int = 5): DashboardSummary!
}